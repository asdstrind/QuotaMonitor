<Window x:Class="QuotaMonitor.Views.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuotaMonitor.Views"
        Icon="/Assets/QuotaMonitor.ico" Title="AI Quota Monitor" Width="176" Height="8" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource TextFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" MouseEnter="OnEnter" MouseLeave="OnLeave" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonDown="HeaderDown" PreviewMouseMove="HeaderMove" PreviewMouseLeftButtonUp="HeaderUp" LostMouseCapture="HeaderCaptureLost">
 <Window.Resources>
  <Style x:Key="CompactHarnessName" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="TextTrimming" Value="None"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
  <Style x:Key="OptionalMicro" TargetType="TextBlock" BasedOn="{StaticResource Micro}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style x:Key="OptionalCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <!-- Column header: platform capsule, name, and a freshness/state readout that turns into a warning when it matters. -->
  <DataTemplate x:Key="ColumnHeader">
   <DockPanel LastChildFill="False" MinHeight="22">
    <local:HarnessMark DockPanel.Dock="Left" Provider="{Binding Id}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,1,8,0"/>
    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource Name}"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding StateIsWarning,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,1,4,0" Visibility="{Binding StateIsWarning,Converter={StaticResource BoolVisibility}}"/>
     <TextBlock Text="{Binding StateText}" Style="{StaticResource Micro}" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </DataTemplate>
  <!-- Balance readout: currency and cents step back so the whole amount reads at a glance. -->
  <DataTemplate x:Key="BalanceColumn">
   <StackPanel Background="Transparent">
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnHeader}" Focusable="False"/>
    <TextBlock Style="{StaticResource Readout}" FontSize="30" Margin="0,9,0,0" Opacity="{Binding ValueOpacity}" TextTrimming="CharacterEllipsis">
     <Run Text="{Binding AmountSymbol,Mode=OneWay}" FontSize="16" Foreground="{StaticResource Ink2}"/><Run Text="{Binding AmountMajor,Mode=OneWay}" FontSize="30"/><Run Text="{Binding AmountMinor,Mode=OneWay}" FontSize="16" Foreground="{StaticResource Ink2}"/>
    </TextBlock>
    <TextBlock Text="{Binding AmountCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding DetailLine}" Style="{StaticResource OptionalCaption}" Margin="0,7,0,0"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="QuotaColumn">
   <StackPanel Background="Transparent">
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnHeader}" Focusable="False"/>
    <ItemsControl ItemsSource="{Binding Gauges}" Margin="0,13,0,0" Opacity="{Binding ValueOpacity}" Focusable="False">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Style="{StaticResource Readout}" FontSize="26" VerticalAlignment="Top"><Run Text="{Binding Value,Mode=OneWay}"/><Run Text="&#x200A;%" FontSize="15" Foreground="{StaticResource Ink2}"/></TextBlock>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" Style="{StaticResource Micro}" Foreground="{StaticResource Ink2}" Margin="0,0,0,4"/><ProgressBar Value="{Binding Remaining,Mode=OneWay}" Foreground="{Binding DataContext.Accent,RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource Meter}"/></StackPanel>
       <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Reset}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding EmptyText}" Margin="0,14,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGauges}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
  </DataTemplate>
 </Window.Resources>
 <Grid>
 <local:MorphSurface x:Name="Island" UseLayoutRounding="False" SnapsToDevicePixels="False"/>
 <local:MorphLayoutHost x:Name="ContentSurface">
 <local:AlertReadout x:Name="AlertStrip" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="26" Opacity="0" IsHitTestVisible="False" UseLayoutRounding="False"/>
 <Border x:Name="Minimal" HorizontalAlignment="Center" VerticalAlignment="Top" Width="174" Height="7" CornerRadius="1,1,5,5" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="MinimalStrip" AutomationProperties.Name="{Binding MinimalTooltip}">
  <!-- A quiet, centered grip indicates the tucked-away panel, without implying quota status. -->
  <Border Width="32" Height="2" CornerRadius="1" Background="#77818F" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
 </Border>
   <!-- Collapsed pill: the three live values, unchanged in meaning. -->
   <Grid x:Name="Compact" Width="620" HorizontalAlignment="Center" Height="56" VerticalAlignment="Top" Margin="0" Background="Transparent" Cursor="Hand" AutomationProperties.AutomationId="CollapsedCapsule">
    <ItemsControl x:Name="CompactItems" ItemsSource="{Binding VisibleProviders}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Margin="12,0">
       <local:HarnessMark Provider="{Binding Id}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink2}" Style="{StaticResource CompactHarnessName}" VerticalAlignment="Center" Margin="0,0,9,0"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Compact}" Style="{StaticResource Readout}" FontSize="16"/>
       </StackPanel>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoVisibleProviders,Converter={StaticResource BoolVisibility}}"><TextBlock Text="未选择平台" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding SettingsCommand}"/></StackPanel>
   </Grid>

   <!-- Expanded island: instrument strip, then the usage calendar. No scrolling anywhere. -->
   <Grid x:Name="Details" Width="694" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" Margin="20,16,12,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Strip" Background="Transparent">
     <Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="124"/><Style.Triggers><DataTrigger Binding="{Binding NoVisibleProviders}" Value="True"><Setter Property="MinHeight" Value="70"/></DataTrigger></Style.Triggers></Style></Grid.Style>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
     <ItemsControl x:Name="Instruments" ItemsSource="{Binding VisibleProviders}" Focusable="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
        <ContentControl Content="{Binding}" Focusable="False"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource BalanceColumn}"/><Style.Triggers><DataTrigger Binding="{Binding IsQuota}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource QuotaColumn}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel VerticalAlignment="Center" Visibility="{Binding NoVisibleProviders,Converter={StaticResource BoolVisibility}}"><TextBlock Text="选择你想看到的平台" FontSize="17" Foreground="{StaticResource Ink}"/><TextBlock Text="在设置中勾选 Harness 即可恢复显示" Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0">
      <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="Refresh" Margin="0,2,0,0"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding SettingsCommand}" AutomationProperties.AutomationId="Settings" Margin="0,2,0,0"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="1" Height="1" Background="{StaticResource Hairline}" Margin="0,6,8,0" Visibility="{Binding HasVisibleProviders,Converter={StaticResource BoolVisibility}}"/>
    <DockPanel x:Name="HeatmapHeading" Grid.Row="2" Margin="7,13,8,8" LastChildFill="False" Visibility="{Binding HasVisibleProviders,Converter={StaticResource BoolVisibility}}">
     <TextBlock DockPanel.Dock="Left" Text="每日 Token" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
     <TextBlock DockPanel.Dock="Left" Text="近 26 周" Style="{StaticResource Micro}" Margin="9,1,0,0" VerticalAlignment="Center"/>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
      <TextBlock Text="少" Style="{StaticResource Micro}" Margin="0,0,5,0"/>
      <Border Width="9" Height="9" CornerRadius="2" Background="{Binding IntensityLow}" Margin="0,0,3,0"/>
      <Border Width="9" Height="9" CornerRadius="2" Background="{Binding IntensityMid}" Margin="0,0,3,0"/>
      <Border Width="9" Height="9" CornerRadius="2" Background="{Binding IntensityHigh}" Margin="0,0,5,0"/>
      <TextBlock Text="多" Style="{StaticResource Micro}"/>
     </StackPanel>
    </DockPanel>
    <local:UsageHeatmap x:Name="Heatmap" Grid.Row="3" Data="{Binding Grid}" FocusLane="{Binding FocusLane}" HorizontalAlignment="Center" Margin="0,0,8,0" Hovered="HeatmapHovered" Visibility="{Binding HasVisibleProviders,Converter={StaticResource BoolVisibility}}"/>
    <ItemsControl x:Name="HarnessLegend" Grid.Row="4" ItemsSource="{Binding Lanes}" Margin="0,6,8,0" HorizontalAlignment="Left" Focusable="False" Visibility="{Binding HasVisibleProviders,Converter={StaticResource BoolVisibility}}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Tag="{Binding Id}" CornerRadius="9" Padding="7,7,9,7" Margin="0,0,6,0" Cursor="Hand" MouseEnter="LaneEnter" MouseLeave="LaneLeave">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#14FFFFFF"/></Trigger><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Background" Value="#24FFFFFF"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <StackPanel Orientation="Horizontal">
        <local:HarnessMark Provider="{Binding Id}" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Total}" Style="{StaticResource Readout}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,8,0" Visibility="{Binding HasNotice,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>

   <!-- Day readout floats above everything inside the island; values lead, names follow. -->
   <Canvas x:Name="Overlay" IsHitTestVisible="False">
    <Border x:Name="TipCard" Visibility="Collapsed" DataContext="{Binding Tip}" Background="#17191D" BorderBrush="#33363D" BorderThickness="1" CornerRadius="10" Padding="11,8,12,9" MinWidth="210">
     <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.6"/></Border.Effect>
     <StackPanel>
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="NoWrap" Margin="0,0,0,5"/>
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,2,0,2">
         <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto" MinWidth="58"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="9" Height="3" CornerRadius="1.5" Background="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
         <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Readout}" FontSize="13.5" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Detail}" Style="{StaticResource OptionalMicro}" FontSize="11" VerticalAlignment="Center"/>
          <Border CornerRadius="6" Background="#26FFFFFF" Padding="5,0,5,1" Margin="6,0,0,0" VerticalAlignment="Center">
           <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Flag}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
           <TextBlock Text="{Binding Flag}" FontSize="10" Foreground="{StaticResource Ink2}" TextWrapping="NoWrap"/>
          </Border>
         </StackPanel>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" TextTrimming="None" MaxWidth="270" HorizontalAlignment="Left" Margin="0,6,0,0">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Micro}"><Style.Triggers><DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </Border>
   </Canvas>
  </local:MorphLayoutHost>
 </Grid>
</Window>






<Window x:Class="QuotaMonitor.Views.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuotaMonitor.Views"
        Icon="/Assets/QuotaMonitor.ico" Title="AI Quota Monitor" Width="176" Height="8" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource TextFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" MouseEnter="OnEnter" MouseLeave="OnLeave" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonDown="HeaderDown" PreviewMouseMove="HeaderMove" PreviewMouseLeftButtonUp="HeaderUp" LostMouseCapture="HeaderCaptureLost">
 <Window.Resources>
  <Style x:Key="OptionalMicro" TargetType="TextBlock" BasedOn="{StaticResource Micro}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style x:Key="OptionalCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <!-- Column header: platform capsule, name, and a freshness/state readout that turns into a warning when it matters. -->
  <DataTemplate x:Key="ColumnHeader">
   <DockPanel LastChildFill="False">
    <Border DockPanel.Dock="Left" Width="10" Height="4" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,1,8,0"/>
    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource Name}"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,1,4,0" Visibility="{Binding StateIsWarning,Converter={StaticResource BoolVisibility}}"/>
     <TextBlock Text="{Binding StateText}" Style="{StaticResource Micro}" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </DataTemplate>
  <!-- Balance readout: currency and cents step back so the whole amount reads at a glance. -->
  <DataTemplate x:Key="BalanceColumn">
   <StackPanel Background="Transparent" ToolTip="{Binding Tooltip}">
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnHeader}" Focusable="False"/>
    <TextBlock Style="{StaticResource Readout}" Margin="0,9,0,0" Opacity="{Binding ValueOpacity}" TextTrimming="CharacterEllipsis">
     <Run Text="{Binding AmountSymbol,Mode=OneWay}" FontSize="18" Foreground="{StaticResource Ink2}"/><Run Text="{Binding AmountMajor,Mode=OneWay}" FontSize="34"/><Run Text="{Binding AmountMinor,Mode=OneWay}" FontSize="18" Foreground="{StaticResource Ink2}"/>
    </TextBlock>
    <TextBlock Text="{Binding AmountCaption}" Style="{StaticResource Caption}" Margin="0,-1,0,0"/>
    <TextBlock Text="{Binding DetailLine}" Style="{StaticResource OptionalMicro}" Margin="0,5,0,0"/>
   </StackPanel>
  </DataTemplate>
 </Window.Resources>
 <Grid>
 <local:MorphSurface x:Name="Island" UseLayoutRounding="False" SnapsToDevicePixels="False"/>
 <local:MorphLayoutHost x:Name="ContentSurface">
 <local:AlertReadout x:Name="AlertStrip" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="26" Opacity="0" IsHitTestVisible="False" UseLayoutRounding="False"/>
 <Border x:Name="Minimal" HorizontalAlignment="Center" VerticalAlignment="Top" Width="174" Height="7" CornerRadius="1,1,5,5" Background="Transparent" BorderThickness="0" ToolTip="{Binding MinimalTooltip}" AutomationProperties.AutomationId="MinimalStrip" AutomationProperties.Name="{Binding MinimalTooltip}">
  <!-- A quiet, centered grip indicates the tucked-away panel, without implying quota status. -->
  <Border Width="32" Height="2" CornerRadius="1" Background="#77818F" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
 </Border>
   <!-- Collapsed pill: the three live values, unchanged in meaning. -->
   <Grid x:Name="Compact" Width="460" HorizontalAlignment="Center" Height="56" VerticalAlignment="Top" Margin="0" Background="Transparent" ToolTip="点击任意位置展开，拖动移动" Cursor="Hand" AutomationProperties.AutomationId="CollapsedCapsule">
    <ItemsControl ItemsSource="{Binding Providers}" VerticalAlignment="Center" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding CompactTooltip}">
       <Border Width="10" Height="4" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Compact}" Style="{StaticResource Readout}" FontSize="16" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding CompactUpdated}" Style="{StaticResource OptionalMicro}" FontSize="9" Margin="0,-2,0,0"/>
       </StackPanel>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>

   <!-- Expanded island: instrument strip, then the usage calendar. No scrolling anywhere. -->
   <Grid x:Name="Details" Width="694" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Margin="20,16,12,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Strip" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
     <StackPanel DataContext="{Binding Codex}" Margin="0,0,18,0" Background="Transparent" ToolTip="{Binding Tooltip}">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnHeader}" Focusable="False"/>
      <ItemsControl ItemsSource="{Binding Gauges}" Margin="0,12,0,0" Opacity="{Binding ValueOpacity}" Focusable="False">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Grid.RowSpan="2" Style="{StaticResource Readout}" VerticalAlignment="Top" Margin="0,-4,0,0"><Run Text="{Binding Value,Mode=OneWay}" FontSize="25"/><Run Text="%" FontSize="13" Foreground="{StaticResource Ink2}"/></TextBlock>
         <DockPanel Grid.Column="1" Margin="0,2,0,0">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Label}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
          <ProgressBar Value="{Binding Remaining,Mode=OneWay}" VerticalAlignment="Center">
           <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource Meter}"><Style.Triggers><DataTrigger Binding="{Binding Low}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
          </ProgressBar>
         </DockPanel>
         <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Reset}" Style="{StaticResource Micro}" Margin="0,3,0,0"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding EmptyText}" Margin="0,14,0,0">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGauges}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
     <Border Grid.Column="1" Background="{StaticResource Hairline}" Margin="0,2,0,8"/>
     <ContentControl Grid.Column="2" Content="{Binding Claude}" ContentTemplate="{StaticResource BalanceColumn}" Margin="18,0,18,0" Focusable="False"/>
     <Border Grid.Column="3" Background="{StaticResource Hairline}" Margin="0,2,0,8"/>
     <ContentControl Grid.Column="4" Content="{Binding Dsh}" ContentTemplate="{StaticResource BalanceColumn}" Margin="18,0,6,0" Focusable="False"/>
     <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0">
      <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="{Binding Message}" AutomationProperties.AutomationId="Refresh" Margin="0,2,0,0"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding SettingsCommand}" ToolTip="设置" AutomationProperties.AutomationId="Settings" Margin="0,2,0,0"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="1" Height="1" Background="{StaticResource Hairline}" Margin="0,6,8,0"/>
    <DockPanel Grid.Row="2" Margin="0,13,8,4" LastChildFill="False">
     <TextBlock DockPanel.Dock="Left" Text="每日 Token" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
     <TextBlock DockPanel.Dock="Left" Text="近 26 周" Style="{StaticResource Micro}" FontSize="11.5" Margin="9,1,0,0" VerticalAlignment="Center"/>
     <Border DockPanel.Dock="Right" Background="{StaticResource Raised}" CornerRadius="11" Padding="2" VerticalAlignment="Center" ToolTip="统一刻度：三个平台共用一把对数刻度，柱高可以直接比较。&#x0a;各自刻度：每个平台按自身的常见峰值缩放，便于看清低用量平台的节奏。">
      <StackPanel Orientation="Horizontal">
       <RadioButton Style="{StaticResource Segment}" Content="统一刻度" GroupName="HeatScale" IsChecked="{Binding UnifiedScale}" AutomationProperties.AutomationId="ScaleUnified"/>
       <RadioButton Style="{StaticResource Segment}" Content="各自刻度" GroupName="HeatScale" IsChecked="{Binding RelativeScale}" AutomationProperties.AutomationId="ScaleRelative"/>
      </StackPanel>
     </Border>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="柱高为当日 Token 的对数刻度；颜色与左右位置对应平台。">
      <Ellipse Width="4" Height="4" Fill="#5C616B" VerticalAlignment="Center"/><TextBlock Text="零用量" Style="{StaticResource Micro}" Margin="5,0,11,0" VerticalAlignment="Center"/>
      <Border Width="5" Height="13" CornerRadius="2.5" BorderBrush="#B9BEC7" BorderThickness="1" Background="#2EB9BEC7" VerticalAlignment="Center"/><TextBlock Text="推算" Style="{StaticResource Micro}" Margin="5,0,11,0" VerticalAlignment="Center"/>
      <Grid Width="11" Height="11" VerticalAlignment="Center"><Border BorderBrush="#3A3D44" BorderThickness="1" CornerRadius="3"/><Ellipse Width="3" Height="3" Fill="#C9CDD4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1.5,1.5,0"/></Grid><TextBlock Text="不完整" Style="{StaticResource Micro}" Margin="5,0,11,0" VerticalAlignment="Center"/>
      <TextBlock Text="空位无记录" Style="{StaticResource Micro}" VerticalAlignment="Center"/>
     </StackPanel>
    </DockPanel>
    <local:UsageHeatmap x:Name="Heatmap" Grid.Row="3" Data="{Binding Grid}" Relative="{Binding RelativeScale}" FocusLane="{Binding FocusLane}" Margin="0,0,8,0" Hovered="HeatmapHovered"/>
    <ItemsControl Grid.Row="4" ItemsSource="{Binding Lanes}" Margin="18,6,8,0" HorizontalAlignment="Left" Focusable="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Tag="{Binding Id}" CornerRadius="9" Padding="7,3,9,3" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding Detail}" MouseEnter="LaneEnter" MouseLeave="LaneLeave" MouseLeftButtonUp="LaneClick">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#14FFFFFF"/></Trigger><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Background" Value="#24FFFFFF"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <StackPanel Orientation="Horizontal">
        <Border Width="4" Height="11" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Total}" Style="{StaticResource Readout}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource OptionalMicro}" Margin="7,1,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,8,0" Visibility="{Binding HasNotice,Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>

   <!-- Day readout floats above everything inside the island; values lead, names follow. -->
   <Canvas x:Name="Overlay" IsHitTestVisible="False">
    <Border x:Name="TipCard" Visibility="Collapsed" DataContext="{Binding Tip}" Background="#17191D" BorderBrush="#33363D" BorderThickness="1" CornerRadius="10" Padding="11,8,12,9" MinWidth="210">
     <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.6"/></Border.Effect>
     <StackPanel>
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="NoWrap" Margin="0,0,0,5"/>
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,2,0,2">
         <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto" MinWidth="58"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="9" Height="3" CornerRadius="1.5" Background="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
         <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Readout}" FontSize="13.5" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Detail}" Style="{StaticResource OptionalMicro}" FontSize="11" VerticalAlignment="Center"/>
          <Border CornerRadius="6" Background="#26FFFFFF" Padding="5,0,5,1" Margin="6,0,0,0" VerticalAlignment="Center">
           <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Flag}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
           <TextBlock Text="{Binding Flag}" FontSize="10" Foreground="{StaticResource Ink2}" TextWrapping="NoWrap"/>
          </Border>
         </StackPanel>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" TextTrimming="None" MaxWidth="270" HorizontalAlignment="Left" Margin="0,6,0,0">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Micro}"><Style.Triggers><DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </Border>
   </Canvas>
  </local:MorphLayoutHost>
 </Grid>
</Window>






  <Style TargetType="TextBox"><Setter Property="Background" Value="#0C0D10"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderBrush" Value="#34373E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="#86DEC3"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#86DEC3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Input" Property="Background" Value="#17191D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0C0D10"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderBrush" Value="#34373E"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#E9AB8D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Background" Value="#0C0D10"/><Setter Property="Padding" Value="11,9"/><Setter Property="MinHeight" Value="36"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" Background="#0C0D10" BorderBrush="#34373E" BorderThickness="1" CornerRadius="10"><TextBlock Text="⌄" FontFamily="Bahnschrift" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#17191D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,8,28,8" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="#191B20" CornerRadius="10" BorderBrush="#3B3E45" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220" Margin="0,4,0,0" Padding="4"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#17191D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Background" Value="#22242B"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style x:Key="SettingsScroll" TargetType="ScrollBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="5" MinWidth="0" MaxWidth="5"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#434751" CornerRadius="2.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="Expander"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Cursor="Hand"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderBox" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="Arrow" Text="›" FontSize="19" Foreground="#9298A3" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform></TextBlock><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBox" Property="Background" Value="#202228"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBox" Property="BorderBrush" Value="#86DEC3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="ExpandedSite" Content="{TemplateBinding Content}" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#090A0C" BorderBrush="#35383E" BorderThickness="1" CornerRadius="22" Padding="0">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="146"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="3" MouseLeftButtonDown="HeaderDrag"><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Border Width="25" Height="8" Background="#86DEC3" CornerRadius="4" Margin="0,7,10,0" VerticalAlignment="Top"/><TextBlock Text="QuotaMonitor" FontSize="17" FontWeight="SemiBold"/><TextBlock Text=" / SETTINGS" Style="{StaticResource Hint}" Margin="8,3,0,0"/></StackPanel><Button Content="×" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Padding="8" Click="CancelClick" ToolTip="关闭设置 · Esc" AutomationProperties.Name="关闭设置"/></Grid>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><RadioButton x:Name="GeneralNav" Style="{StaticResource Nav}" GroupName="Pages" Content="常规 / General" Tag="General" Checked="Navigate" AutomationProperties.AutomationId="GeneralNav"/><RadioButton x:Name="ProvidersNav" Style="{StaticResource Nav}" GroupName="Pages" Content="平台 / Providers" Tag="Providers" Checked="Navigate" AutomationProperties.AutomationId="ProvidersNav"/><RadioButton x:Name="AlertsNav" Style="{StaticResource Nav}" GroupName="Pages" Content="提醒 / Alerts" Tag="Alerts" Checked="Navigate" AutomationProperties.AutomationId="AlertsNav"/><RadioButton x:Name="AdvancedNav" Style="{StaticResource Nav}" GroupName="Pages" Content="高级 / Advanced" Tag="Advanced" Checked="Navigate" AutomationProperties.AutomationId="AdvancedNav"/></StackPanel><StackPanel x:Name="Branding" Grid.Row="1" Margin="12,0,0,14"><TextBlock Text="ALWAYS IN VIEW" Style="{StaticResource Hint}" FontSize="9"/><TextBlock Text="v1.5.1" Foreground="#5E6570" FontSize="11" Margin="0,6,0,0"/></StackPanel></Grid>
  <Grid Grid.Row="1" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,1,0,18"><TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" CanContentScroll="{TemplateBinding CanContentScroll}"/><ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SettingsScroll}" Grid.Column="1" Orientation="Vertical" Width="5" MaxWidth="5" ClipToBounds="True" Margin="4,0,0,0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/></Grid></ControlTemplate></ScrollViewer.Template><Grid x:Name="PageHost" Margin="0,0,9,0">
    <StackPanel x:Name="GeneralPage">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="让灵动岛融入你的桌面" FontSize="16" Margin="0,0,0,18"/>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="顶部居中"/><TextBlock Text="关闭后可拖动到自定义位置" Style="{StaticResource Hint}" Margin="0,5,14,0"/></StackPanel><CheckBox x:Name="CenterOn" Grid.Column="1" AutomationProperties.Name="顶部居中"/></Grid>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="全屏时隐藏"/><TextBlock Text="为游戏、视频和演示留出空间" Style="{StaticResource Hint}" Margin="0,5,14,0"/></StackPanel><CheckBox x:Name="FullscreenOn" Grid.Column="1" AutomationProperties.Name="全屏时隐藏"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开机启动"/><TextBlock Text="登录 Windows 后自动开始监控" Style="{StaticResource Hint}" Margin="0,5,14,0"/></StackPanel><CheckBox x:Name="StartupOn" Grid.Column="1" AutomationProperties.Name="开机启动"/></Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="自动刷新 · 已准备好" Foreground="#86DEC3"/><TextBlock Text="各平台独立更新，过期数据保留并标记 Stale。刷新频率可在高级设置中调整。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel></Border>
     <TextBlock Text="Minimal → Collapsed → Expanded" Style="{StaticResource Hint}" Margin="4,4,0,0"/><TextBlock Text="熟悉的形态、连续动画与三平台历史热力图。" Style="{StaticResource Hint}" Margin="4,5,0,0"/>
    </StackPanel>
    <StackPanel x:Name="ProvidersPage" Visibility="Collapsed">
     <Border Background="#141518" CornerRadius="12" Padding="4" Margin="0,0,0,16"><UniformGrid Columns="3"><RadioButton x:Name="CodexTab" Content="Codex" Tag="Codex" GroupName="Provider" Style="{StaticResource Nav}" Padding="12,8" Margin="0" Checked="ProviderNavigate"/><RadioButton x:Name="ClaudeTab" Content="ClaudeCN" Tag="Claude" GroupName="Provider" Style="{StaticResource Nav}" Padding="12,8" Margin="0" Checked="ProviderNavigate"/><RadioButton x:Name="DshTab" Content="DSH" Tag="Dsh" GroupName="Provider" Style="{StaticResource Nav}" Padding="12,8" Margin="0" Checked="ProviderNavigate"/></UniformGrid></Border>
     <StackPanel x:Name="CodexPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="Codex" Foreground="#86DEC3" FontSize="19"/><CheckBox x:Name="CodexOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 Codex"/></Grid><TextBlock Text="使用本机登录 · 自动发现" Style="{StaticResource Hint}" Margin="0,10,0,22"/><TextBlock Text="5 小时 + 每周额度" FontSize="16"/><TextBlock Text="复用 Codex CLI 的 ChatGPT 登录。无需额外 API Key，额度窗口与重置时间来自账户响应。" Style="{StaticResource Hint}" Margin="0,8,0,18"/><TextBlock Text="自定义可执行文件路径位于高级设置。" Style="{StaticResource Hint}"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="ClaudePanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="ClaudeCN" Foreground="#E9AB8D" FontSize="19"/><CheckBox x:Name="ClaudeOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 ClaudeCN"/></Grid><TextBlock Text="账户余额 · 消费 · 历史用量" Style="{StaticResource Hint}" Margin="0,8,0,4"/><TextBlock Text="System Access Token" Style="{StaticResource Label}"/><PasswordBox x:Name="TokenBox" AutomationProperties.AutomationId="ClaudeToken"/><TextBlock x:Name="CredentialLabel" Style="{StaticResource Hint}" Margin="0,6,0,0"/><TextBlock Text="数字 User ID" Style="{StaticResource Label}"/><TextBox x:Name="UserIdBox" AutomationProperties.AutomationId="ClaudeUserId"/><Grid Margin="0,14,0,0"><Button x:Name="TestButton" Content="测试连接" HorizontalAlignment="Left" Click="TestClick" AutomationProperties.AutomationId="TestConnection"/><Button x:Name="RemoveToken" Content="移除已存 Token" HorizontalAlignment="Right" Background="Transparent" Click="DeleteTokenClick" AutomationProperties.AutomationId="RemoveToken"/></Grid><TextBlock x:Name="TestResult" Foreground="#86DEC3" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="留空保留已存 Token。新 Token 仅在保存后写入 Windows 凭据管理器；移除操作也在保存后生效。" Style="{StaticResource Hint}" Margin="4,0,4,0"/></StackPanel>
     <StackPanel x:Name="DshPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="DeepSeek Harness" Foreground="#89B8FA" FontSize="19"/><CheckBox x:Name="DshOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 DSH"/></Grid><TextBlock Text="零配置监控" Foreground="#89B8FA" Margin="0,10,0,22"/><TextBlock Text="余额 / 官方 Balance Bridge"/><TextBlock Text="自动同步官方账户快照，保留充值与赠送钱包的原始币种。" Style="{StaticResource Hint}" Margin="0,6,0,18"/><TextBlock Text="Token / 本地 Session"/><TextBlock Text="自动读取主会话与子 Agent 的真实用量，并汇入历史热力图。" Style="{StaticResource Hint}" Margin="0,6,0,18"/><TextBlock Text="模型 / 自动识别"/><TextBlock x:Name="DshModelLabel" Foreground="#89B8FA" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="无需填写模型或价格。费用仅在模型与价格依据匹配时估算，始终标记 Estimated；它不是官方账单。" Style="{StaticResource Hint}" Margin="4,0,4,0"/></StackPanel>
    </StackPanel>
    <StackPanel x:Name="AlertsPage" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Codex · 剩余额度" Foreground="#86DEC3" FontSize="16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="5 小时 / %" Style="{StaticResource Label}"/><TextBox x:Name="FiveHourThreshold" AutomationProperties.AutomationId="FiveHourThreshold"/></StackPanel><StackPanel><TextBlock Text="每周 / %" Style="{StaticResource Label}"/><TextBox x:Name="WeeklyThreshold" AutomationProperties.AutomationId="WeeklyThreshold"/></StackPanel></UniformGrid></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ClaudeCN · 余额" Foreground="#E9AB8D" FontSize="16"/><TextBlock Text="低于 / USD" Style="{StaticResource Label}"/><TextBox x:Name="ClaudeThreshold" AutomationProperties.AutomationId="ClaudeThreshold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DSH · 充值余额" Foreground="#89B8FA" FontSize="16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="低于" Style="{StaticResource Label}"/><TextBox x:Name="DshThreshold" AutomationProperties.AutomationId="DshThreshold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="币种" Style="{StaticResource Label}"/><ComboBox x:Name="DshAlertCurrencyBox" AutomationProperties.AutomationId="DshAlertCurrency"><ComboBoxItem Content="CNY"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel></Grid></StackPanel></Border>
     <TextBlock Text="0 关闭对应提醒。仅在新鲜的真实数据严格低于阈值时显示 Alert Minimal；DSH 不计赠送钱包，不换算币种。" Style="{StaticResource Hint}" Margin="4,0,4,0"/>
    </StackPanel>
    <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel><Expander Header="刷新频率 / 秒" x:Name="RefreshExpander"><StackPanel><TextBlock Text="30–3600 秒，各平台独立刷新。" Style="{StaticResource Hint}" Margin="0,10,0,0"/><UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="Codex" Style="{StaticResource Label}"/><TextBox x:Name="CodexInterval"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="ClaudeCN" Style="{StaticResource Label}"/><TextBox x:Name="ClaudeInterval"/></StackPanel><StackPanel><TextBlock Text="DSH" Style="{StaticResource Label}"/><TextBox x:Name="DshInterval"/></StackPanel></UniformGrid></StackPanel></Expander><Expander Header="路径覆盖 / 默认自动发现" x:Name="PathsExpander"><StackPanel><TextBlock Text="留空使用自动发现。目录尚未出现也可保存，安装或运行 DSH 后自动读取。" Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="Codex 原生 .exe" Style="{StaticResource Label}"/><TextBox x:Name="CodexPathBox"/><TextBlock Text="DSH Session 目录" Style="{StaticResource Label}"/><TextBox x:Name="DshPathBox"/></StackPanel></Expander><Expander Header="ClaudeCN / 金额换算" x:Name="RatioExpander"><StackPanel><TextBlock Text="Quota / USD" Style="{StaticResource Label}"/><TextBox x:Name="RatioBox"/><TextBlock Text="默认 500000。消费统计按额度换算；订阅优先时不代表钱包实际扣款。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="DSH · Estimated Cost" Foreground="#89B8FA" FontSize="16"/><CheckBox x:Name="EstimateOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 DSH 费用估算"/></Grid><TextBlock Text="可关闭估算，不影响余额、Token 或热力图。沿用已有价格快照，仅匹配的模型参与估算。" Style="{StaticResource Hint}" Margin="0,10,0,12"/><Expander x:Name="PriceExpander" Header="可选 / 模型与价格覆盖"><StackPanel><TextBlock Text="不会自动下载价格。未知模型、混合未定价模型或未定价缓存写入保持费用未知。" Style="{StaticResource Hint}" Margin="0,12,0,0"/><TextBlock Text="定价模型 ID（与 Session 精确匹配）" Style="{StaticResource Label}"/><TextBox x:Name="PriceModel"/><TextBlock Text="价格依据 / 核对日期" Style="{StaticResource Label}"/><TextBox x:Name="PriceBasis" TextWrapping="Wrap"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="输入 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceInput"/><TextBlock Text="缓存写入 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceWrite"/></StackPanel><StackPanel><TextBlock Text="缓存读取 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceRead"/><TextBlock Text="输出 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceOutput"/></StackPanel></UniformGrid><TextBlock Text="估算币种 / CNY 或 USD" Style="{StaticResource Label}"/><ComboBox x:Name="PriceCurrency"><ComboBoxItem Content="USD"/><ComboBoxItem Content="CNY"/></ComboBox></StackPanel></Expander></StackPanel></Border>
    </StackPanel>

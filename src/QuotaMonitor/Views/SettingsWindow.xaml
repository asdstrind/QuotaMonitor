     <StackPanel x:Name="DshPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><StackPanel Orientation="Horizontal"><local:HarnessMark Provider="dsh" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="DeepSeek Harness" Foreground="{StaticResource Ink}" FontSize="19"/></StackPanel><CheckBox x:Name="DshOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 DSH"/></Grid><TextBlock Text="零配置监控" Foreground="{StaticResource Ink2}" Margin="0,10,0,22"/><TextBlock Text="余额 / 官方 Balance Bridge"/><TextBlock Text="自动同步官方账户快照，保留充值与赠送钱包的原始币种。" Style="{StaticResource Hint}" Margin="0,6,0,18"/><TextBlock Text="Token / 本地 Session"/><TextBlock Text="自动读取主会话与子 Agent 的真实用量，并汇入历史热力图。" Style="{StaticResource Hint}" Margin="0,6,0,18"/><TextBlock Text="模型 / 自动识别"/><TextBlock x:Name="DshModelLabel" Foreground="{StaticResource Ink2}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="无需填写模型或价格。费用仅在模型与价格依据匹配时估算，始终标记 Estimated；它不是官方账单。" Style="{StaticResource Hint}" Margin="4,0,4,0"/></StackPanel>
     <StackPanel x:Name="AntigravityPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><StackPanel Orientation="Horizontal"><local:HarnessMark Provider="antigravity" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Antigravity" Foreground="{StaticResource Ink}" FontSize="19"/></StackPanel><CheckBox x:Name="AntigravityOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 Antigravity 读取"/></Grid><TextBlock Text="两项 Weekly · 本地只读" Foreground="{StaticResource Ink2}" Margin="0,12,0,18"/><TextBlock Text="Gemini Models / Claude and GPT models"/><TextBlock Text="请保持已登录的官方 Antigravity 客户端运行。自动发现同一 Windows 用户的 Language Server，仅访问其本机回环端口。" Style="{StaticResource Hint}" Margin="0,8,0,18"/><TextBlock Text="不自动登录、不读取账户凭证文件、不发送到第三方。退出或读取失败会标记 Stale / Unavailable。" Style="{StaticResource Hint}"/><TextBlock Text="本地 Token 历史" Foreground="{StaticResource Ink2}" Margin="0,18,0,6"/><TextBlock Text="独立只读扫描本机 Antigravity SQLite；无 SQLite 时读取已有 Tokscale 会话缓存。不完整状态仅包含已确认用量，缺失不是零；与两项 Weekly 额度池分开统计，不反推 Token。" Style="{StaticResource Hint}"/></StackPanel></Border></StackPanel>
    </StackPanel>
    <StackPanel x:Name="AlertsPage" Visibility="Collapsed">
     <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked,ElementName=ShowCodexCheck,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Codex · 剩余额度" Foreground="{StaticResource Ink}" FontSize="16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="5 小时 / %" Style="{StaticResource Label}"/><TextBox x:Name="FiveHourThreshold" AutomationProperties.AutomationId="FiveHourThreshold"/></StackPanel><StackPanel><TextBlock Text="每周 / %" Style="{StaticResource Label}"/><TextBox x:Name="WeeklyThreshold" AutomationProperties.AutomationId="WeeklyThreshold"/></StackPanel></UniformGrid></StackPanel></Border>
     <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked,ElementName=ShowClaudeCheck,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="ClaudeCN · 余额" Foreground="{StaticResource Ink}" FontSize="16"/><TextBlock Text="低于 / USD" Style="{StaticResource Label}"/><TextBox x:Name="ClaudeThreshold" AutomationProperties.AutomationId="ClaudeThreshold"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked,ElementName=ShowDshCheck,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="DSH · 充值余额" Foreground="{StaticResource Ink}" FontSize="16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="低于" Style="{StaticResource Label}"/><TextBox x:Name="DshThreshold" AutomationProperties.AutomationId="DshThreshold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="币种" Style="{StaticResource Label}"/><ComboBox x:Name="DshAlertCurrencyBox" AutomationProperties.AutomationId="DshAlertCurrency"><ComboBoxItem Content="CNY"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel></Grid></StackPanel></Border>
     <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked,ElementName=ShowAntigravityCheck,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Antigravity · Weekly 剩余额度" Foreground="{StaticResource Ink}" FontSize="16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="Gemini / %" Style="{StaticResource Label}"/><TextBox x:Name="AntigravityGeminiThreshold"/></StackPanel><StackPanel><TextBlock Text="Claude / GPT / %" Style="{StaticResource Label}"/><TextBox x:Name="AntigravityClaudeGptThreshold"/></StackPanel></UniformGrid></StackPanel></Border>
     <TextBlock Text="0 关闭对应提醒。仅在新鲜的真实数据严格低于阈值时显示 Alert Minimal；各平台保持原有额度和币种规则。" Style="{StaticResource Hint}" Margin="4,0,4,0"/>
    </StackPanel>
    <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel><Expander Header="刷新频率 / 秒" x:Name="RefreshExpander"><StackPanel><TextBlock Text="30–3600 秒，各平台独立刷新。" Style="{StaticResource Hint}" Margin="0,10,0,0"/><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0" Visibility="{Binding IsChecked,ElementName=ShowCodexCheck,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Codex" Style="{StaticResource Label}"/><TextBox x:Name="CodexInterval"/></StackPanel><StackPanel Margin="0,0,8,0" Visibility="{Binding IsChecked,ElementName=ShowClaudeCheck,Converter={StaticResource BoolVisibility}}"><TextBlock Text="ClaudeCN" Style="{StaticResource Label}"/><TextBox x:Name="ClaudeInterval"/></StackPanel><StackPanel Visibility="{Binding IsChecked,ElementName=ShowDshCheck,Converter={StaticResource BoolVisibility}}"><TextBlock Text="DSH" Style="{StaticResource Label}"/><TextBox x:Name="DshInterval"/></StackPanel><StackPanel Margin="0,0,0,0" Visibility="{Binding IsChecked,ElementName=ShowAntigravityCheck,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Antigravity" Style="{StaticResource Label}"/><TextBox x:Name="AntigravityInterval"/></StackPanel></UniformGrid></StackPanel></Expander><Expander Header="路径覆盖 / 默认自动发现" x:Name="PathsExpander"><StackPanel><TextBlock Text="留空使用自动发现。目录尚未出现也可保存。" Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Visibility="{Binding IsChecked,ElementName=ShowCodexCheck,Converter={StaticResource BoolVisibility}}" Text="Codex 原生 .exe" Style="{StaticResource Label}"/><TextBox Visibility="{Binding IsChecked,ElementName=ShowCodexCheck,Converter={StaticResource BoolVisibility}}" x:Name="CodexPathBox"/><TextBlock Visibility="{Binding IsChecked,ElementName=ShowDshCheck,Converter={StaticResource BoolVisibility}}" Text="DSH Session 目录" Style="{StaticResource Label}"/><TextBox Visibility="{Binding IsChecked,ElementName=ShowDshCheck,Converter={StaticResource BoolVisibility}}" x:Name="DshPathBox"/></StackPanel></Expander><Expander Visibility="{Binding IsChecked,ElementName=ShowClaudeCheck,Converter={StaticResource BoolVisibility}}" Header="ClaudeCN / 金额换算" x:Name="RatioExpander"><StackPanel><TextBlock Text="Quota / USD" Style="{StaticResource Label}"/><TextBox x:Name="RatioBox"/><TextBlock Text="默认 500000。消费统计按额度换算；订阅优先时不代表钱包实际扣款。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel></Border>
     <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked,ElementName=ShowDshCheck,Converter={StaticResource BoolVisibility}}"><StackPanel><Grid><TextBlock Text="DSH · Estimated Cost" Foreground="{StaticResource Ink}" FontSize="16"/><CheckBox x:Name="EstimateOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 DSH 费用估算"/></Grid><TextBlock Text="可关闭估算，不影响余额、Token 或热力图。沿用已有价格快照，仅匹配的模型参与估算。" Style="{StaticResource Hint}" Margin="0,10,0,12"/><Expander x:Name="PriceExpander" Header="可选 / 模型与价格覆盖"><StackPanel><TextBlock Text="不会自动下载价格。未知模型、混合未定价模型或未定价缓存写入保持费用未知。" Style="{StaticResource Hint}" Margin="0,12,0,0"/><TextBlock Text="定价模型 ID（与 Session 精确匹配）" Style="{StaticResource Label}"/><TextBox x:Name="PriceModel"/><TextBlock Text="价格依据 / 核对日期" Style="{StaticResource Label}"/><TextBox x:Name="PriceBasis" TextWrapping="Wrap"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="输入 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceInput"/><TextBlock Text="缓存写入 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceWrite"/></StackPanel><StackPanel><TextBlock Text="缓存读取 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceRead"/><TextBlock Text="输出 / 每百万 Token" Style="{StaticResource Label}"/><TextBox x:Name="PriceOutput"/></StackPanel></UniformGrid><TextBlock Text="估算币种 / CNY 或 USD" Style="{StaticResource Label}"/><ComboBox x:Name="PriceCurrency"><ComboBoxItem Content="USD"/><ComboBoxItem Content="CNY"/></ComboBox></StackPanel></Expander></StackPanel></Border>
    </StackPanel>
   </Grid></ScrollViewer>
  </Grid>
  <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="SaveError" Foreground="#F0B690" FontSize="11" Margin="168,0,0,8"/><Grid Grid.Row="1"><TextBlock Text="更改在保存后生效" Style="{StaticResource Hint}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="CancelClick" Margin="0,0,8,0" AutomationProperties.AutomationId="CancelSettings"/><Button x:Name="SaveButton" Content="保存设置" BorderBrush="{StaticResource AccentStrong}" Background="{StaticResource AccentSurface}" Foreground="{StaticResource AccentOnDark}" Click="SaveClick" AutomationProperties.AutomationId="SaveSettings"/></StackPanel></Grid></Grid>
 </Grid></Border>
</Window>








     <StackPanel x:Name="CodexPanel" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid><StackPanel Orientation="Horizontal"><local:HarnessMark Provider="codex" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Codex" Foreground="{StaticResource Ink}" FontSize="19"/></StackPanel><CheckBox x:Name="CodexOn" HorizontalAlignment="Right" AutomationProperties.Name="启用 Codex"/></Grid><TextBlock Text="使用本机登录 · 自动发现" Style="{StaticResource Hint}" Margin="0,10,0,22"/><TextBlock Text="5 小时 + 每周额度" FontSize="16"/><TextBlock Text="复用 Codex CLI 的 ChatGPT 登录。无需额外 API Key，额度窗口与重置时间来自账户响应。" Style="{StaticResource Hint}" Margin="0,8,0,18"/><TextBlock Text="自定义可执行文件路径位于高级设置。" Style="{StaticResource Hint}"/></StackPanel></Border></StackPanel>

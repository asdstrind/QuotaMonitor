<Window x:Class="QuotaMonitor.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Icon="/Assets/QuotaMonitor.ico" Title="QuotaMonitor · Settings" Width="790" Height="670" MinWidth="600" MinHeight="360" Background="Transparent" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Bahnschrift, Segoe UI, Microsoft YaHei UI" Foreground="#F2F3F5" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="WindowKeyDown" SizeChanged="SettingsSizeChanged">
